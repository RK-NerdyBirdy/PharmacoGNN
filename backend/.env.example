# --- App ---
PROJECT_NAME=PharmacoGNN
ENVIRONMENT=development

# --- Database (PostgreSQL, async driver) ---
DATABASE_URL=postgresql+asyncpg://pharmacognn:changeme@localhost:5432/pharmacognn
# Set true when DATABASE_URL points at Neon (or any managed Postgres that
# requires TLS) instead of a plain local instance. Leave false for the
# localhost URL above.
DATABASE_SSL_REQUIRE=false

# --- Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Field-level PHI encryption (raw AES-256-GCM key, base64-encoded) ---
# Generate with: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key

# --- CORS (comma-separated, no spaces needed) ---
CORS_ORIGINS=http://localhost:3000
