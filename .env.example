# Config for `docker compose up` (docker-compose.yml reads this file
# automatically as `.env` in the project root). This is separate from
# backend/.env.example, which is for running the backend directly with
# uvicorn/alembic on bare metal against your own Postgres instance.
#
# Copy to `.env` in this same directory: cp .env.example .env

# --- Postgres (the `db` service) ---
POSTGRES_USER=pharmacognn
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pharmacognn
# Keep this alphanumeric. It gets embedded directly into an asyncpg connection
# URL (postgresql+asyncpg://user:PASSWORD@db:5432/db) with no URL-encoding --
# @, :, /, % or other URL-special characters here WILL break the connection
# string. If you need a password with those, set DATABASE_URL directly in
# docker-compose.yml's backend.environment instead of building it from these.

# --- Backend ---
BACKEND_PORT=8000

JWT_SECRET_KEY=replace-with-a-long-random-secret
# Generate with: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key

# Optional: only needed to exercise POST /api/v1/explain/interaction.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Comma-separated origins allowed to call the API from a browser (the planned
# semantic HTML5 + Tailwind frontend's dev server).
CORS_ORIGINS=http://localhost:3000
