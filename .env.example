# Config for `docker compose up` (docker-compose.yml reads this file
# automatically as `.env` in the project root). This is separate from
# backend/.env.example, which is for running the backend directly with
# uvicorn/alembic on bare metal.
#
# Copy to `.env` in this same directory: cp .env.example .env

# --- Database (Neon) ---
# Full connection string from your Neon project (Dashboard -> Connection
# Details), rewritten to the asyncpg driver scheme:
#   postgres://user:password@ep-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require
# becomes:
#   postgresql+asyncpg://user:password@ep-xxxx-xxxx.region.aws.neon.tech/dbname
# Drop the `?sslmode=require` suffix -- asyncpg doesn't parse that libpq-style
# query param, TLS is instead turned on explicitly below via
# DATABASE_SSL_REQUIRE (see backend/app/core/config.py).
DATABASE_URL=postgresql+asyncpg://user:password@your-project.neon.tech/pharmacognn
DATABASE_SSL_REQUIRE=true

# --- Backend ---
BACKEND_PORT=8000

JWT_SECRET_KEY=replace-with-a-long-random-secret
# Generate with: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key

# Optional: only needed to exercise POST /api/v1/explain/interaction.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Comma-separated origins allowed to call the API from a browser (the
# frontend team's dev server).
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_ENABLED=true

# --- Email (MailHog runs as a compose service; UI at http://localhost:8025) ---
# APP_BASE_URL is where invite links point -- the FRONTEND origin, not the API's.
APP_BASE_URL=http://localhost:3000
EMAIL_BACKEND=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_START_TLS=false
EMAIL_FROM=no-reply@pharmacognn.local
MAILHOG_UI_PORT=8025
